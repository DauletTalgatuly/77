interface MatchStrategy {
    int score(User a, User b);
    String getName();
}

class Matchmaker {
    private MatchStrategy strategy;

    public Matchmaker(MatchStrategy strategy) {
        this.strategy = strategy;
    }

    public void setStrategy(MatchStrategy strategy) {
        this.strategy = strategy;
    }

    public void printMatches(User user, ArrayList<User> all) {
        System.out.println("Podbor " + strategy.getName() + ":");
        for (User other : all) {
            if (other != user) {
                int points = strategy.score(user, other);
                System.out.println("  " + other.getName() + " - " + points + " ballov");
            }
        }
    }

    public User findBest(User user, ArrayList<User> all) {
        User best = null;
        int bestScore = -1;
        for (User other : all) {
            if (other != user) {
                int points = strategy.score(user, other);
                if (points > bestScore) {
                    bestScore = points;
                    best = other;
                }
            }
        }
        return best;
    }
}






class CityAgeMatchStrategy implements MatchStrategy {
    public int score(User a, User b) {
        int points = 0;
        if (a.getCity().equalsIgnoreCase(b.getCity())) {
            points += 20;
        }
        int ageDiff = Math.abs(a.getAge() - b.getAge());
        if (ageDiff <= 2) {
            points += 10;
        } else if (ageDiff <= 5) {
            points += 5;
        }
        return points;
    }

    public String getName() {
        return "po gorodu i vozrastu";
    }
}

class CombinedMatchStrategy implements MatchStrategy {
    private ArrayList<MatchStrategy> strategies = new ArrayList<>();
    private ArrayList<Double> weights = new ArrayList<>();

    public CombinedMatchStrategy add(MatchStrategy strategy, double weight) {
        strategies.add(strategy);
        weights.add(weight);
        return this;
    }

    public int score(User a, User b) {
        double total = 0;
        for (int i = 0; i < strategies.size(); i++) {
            total += strategies.get(i).score(a, b) * weights.get(i);
        }
        return (int) Math.round(total);
    }

    public String getName() {
        return "po kombinirovannoy formule";
    }
}

class SecurityUtils {
    private static final int HASH_ROUNDS = 10000;
    private static final int MAX_ATTEMPTS = 3;
    private static final SecureRandom random = new SecureRandom();
    private static final HashMap<User, Integer> failedAttempts = new HashMap<>();

    public static String generateSalt() {
        byte[] bytes = new byte[16];
        random.nextBytes(bytes);
        return toHex(bytes);
    }

    public static String hashPassword(String password, String salt) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            byte[] hash = (salt + password).getBytes(StandardCharsets.UTF_8);
            for (int i = 0; i < HASH_ROUNDS; i++) {
                hash = md.digest(hash);
            }
            return toHex(hash);
        } catch (NoSuchAlgorithmException e) {
            throw new RuntimeException("SHA-256 nedostupen", e);
        }
    }

    public static boolean verifyPassword(String password, String salt, String expectedHash) {
        String hash = hashPassword(password, salt);
        return MessageDigest.isEqual(
                hash.getBytes(StandardCharsets.UTF_8),
                expectedHash.getBytes(StandardCharsets.UTF_8));
    }

    private static String toHex(byte[] bytes) {
        StringBuilder sb = new StringBuilder();
        for (byte b : bytes) {
            sb.append(String.format("%02x", b & 0xff));
        }
        return sb.toString();
    }

    public static boolean isValidName(String name) {
        return name != null && name.matches("[A-Za-z]{2,30}");
    }

    public static boolean isValidAge(int age) {
        return age >= 14 && age <= 30;
    }

    public static boolean isValidEmail(String email) {
        return email != null && email.matches("[A-Za-z0-9._]+@[A-Za-z0-9.]+\\.[A-Za-z]{2,}");
