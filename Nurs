class GenreMatchStrategy implements MatchStrategy {
    public int score(User a, User b) {
        int points = 0;
        for (String genre : a.getGenres()) {
            if (b.getGenres().contains(genre)) {
                points += 10;
            }
        }
        return points;
    }

    public String getName() {
        return "po zhanram";
    }
}

class AuthorMatchStrategy implements MatchStrategy {
    public int score(User a, User b) {
        int points = 0;
        for (String author : a.getAuthors()) {
            if (b.getAuthors().contains(author)) {
                points += 15;
            }
        }
        return points;
    }

    public String getName() {
        return "po avtoram";
    }
}






class User {
    private String name;
    private int age;
    private String city;
    private String email;
    private String salt;
    private String passwordHash;
    private ArrayList<String> genres = new ArrayList<>();
    private ArrayList<String> authors = new ArrayList<>();

    public User(String name, int age, String city, String email, String password) {
        this.name = name;
        this.age = age;
        this.city = city;
        this.email = email;
        this.salt = SecurityUtils.generateSalt();
        this.passwordHash = SecurityUtils.hashPassword(password, salt);
    }

    public void addGenre(String genre) {
        genres.add(genre);
    }

    public void addAuthor(String author) {
        authors.add(author);
    }

    public String getName() {
        return name;
    }

    public int getAge() {
        return age;
    }

    public String getCity() {
        return city;
    }

    public ArrayList<String> getGenres() {
        return genres;
    }

    public ArrayList<String> getAuthors() {
        return authors;
    }

    public boolean checkPassword(String password) {
        return SecurityUtils.verifyPassword(password, salt, passwordHash);
    }

    public String getMaskedEmail() {
        return SecurityUtils.maskEmail(email);
    }

    public String getHashPreview() {
        return passwordHash.substring(0, 16);
    }
}

