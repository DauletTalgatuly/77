interface MatchStrategy {
    int score(User a, User b);   // сколько баллов совместимости
    String getName();
}

// Класс, который использует стратегию
class Matchmaker {
    private MatchStrategy strategy;

    public Matchmaker(MatchStrategy strategy) {
        this.strategy = strategy;
    }

    public void setStrategy(MatchStrategy strategy) {
        this.strategy = strategy;
    }

    public void printMatches(User user, ArrayList<User> all) {
        System.out.println("Подбор " + strategy.getName() + ":");
        for (User other : all) {
            if (other != user) {
                int points = strategy.score(user, other);
                System.out.println("  " + other.getName() + " — " + points + " баллов");
            }
        }
    }

    public User findBest(User user, ArrayList<User> all) {
        User best = null;
        int bestScore = 0;
        for (User other : all) {
            if (other != user) {
                int points = strategy.score(user, other);
                if (points > bestScore) {
                    bestScore = points;
                    best = other;
                }
            }
        }
        return best;
    }
}








class CityAgeMatchStrategy implements MatchStrategy {
    public int score(User a, User b) {
        int points = 0;
        if (a.getCity().equals(b.getCity())) {
            points += 20;
        }
        int ageDiff = Math.abs(a.getAge() - b.getAge());
        if (ageDiff <= 2) {
            points += 10;
        } else if (ageDiff <= 5) {
            points += 5;
        }
        return points;
    }

    public String getName() { return "по городу и возрасту"; }
}

// Стратегия 4: комбинированная формула.
// Складывает баллы других стратегий, каждая умножается на свой вес.
// Новые стратегии добавляются через add() без изменения этого класса.
class CombinedMatchStrategy implements MatchStrategy {
    private ArrayList<MatchStrategy> strategies = new ArrayList<>();
    private ArrayList<Double> weights = new ArrayList<>();

    public CombinedMatchStrategy add(MatchStrategy strategy, double weight) {
        strategies.add(strategy);
        weights.add(weight);
        return this;
    }

    public int score(User a, User b) {
        double total = 0;
        for (int i = 0; i < strategies.size(); i++) {
            total += strategies.get(i).score(a, b) * weights.get(i);
        }
        return (int) Math.round(total);
    }

    public String getName() { return "по комбинированной формуле"; }









// Стратегия 1: по общим жанрам — 10 баллов за каждый общий жанр
class GenreMatchStrategy implements MatchStrategy {
    public int score(User a, User b) {
        int points = 0;
        for (String genre : a.getGenres()) {
            if (b.getGenres().contains(genre)) {
                points += 10;
            }
        }
        return points;
    }

    public String getName() { return "по жанрам"; }
}

// Стратегия 2: по общим любимым авторам — 15 баллов за каждого
class AuthorMatchStrategy implements MatchStrategy {
    public int score(User a, User b) {
        int points = 0;
        for (String author : a.getAuthors()) {
            if (b.getAuthors().contains(author)) {
                points += 15;
            }
        }
        return points;
    }

    public String getName() { return "по авторам"; }
}


